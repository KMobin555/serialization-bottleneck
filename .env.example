# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is not. Never commit real keys.
#
# The runners call `load_dotenv()` with no argument, which searches upward from
# the script's own directory. So `.env` may sit at this repo's root or in any
# parent directory — both are found.
#
# You only need the key for the provider you actually run. A missing key fails
# fast at startup with `<KEY_NAME> not set. Add it to .env.`

# --- Provider API keys -------------------------------------------------------
# DeepSeek direct (https://api.deepseek.com)
#   used by: phase2_model_results/01_v4flash        (deepseek-v4-flash)
#            phase2_model_results/06_v4pro_nonthinking (deepseek-v4-pro)
DEEPSEEK_API_KEY=

# OpenRouter (https://openrouter.ai/api/v1)
#   used by: phase2_model_results/02_qwen3          (qwen/qwen3-32b)
#            phase2_model_results/03_llama_scout    (meta-llama/llama-4-scout)
OPENROUTER_API_KEY=

# Google Gemini, OpenAI-compatible endpoint
# (https://generativelanguage.googleapis.com/v1beta/openai/)
#   used by: phase2_model_results/04_gemini         (gemini-2.5-flash-lite)
GEMINI_API_KEY=

# OpenAI (https://api.openai.com/v1)
#   used by: phase2_model_results/05_gpt            (gpt-4.1-mini)
OPENAI_API_KEY=

# --- Optional: OpenRouter attribution headers --------------------------------
# Sent only when --provider openrouter. Both are optional.
#   OPENROUTER_APP_NAME -> X-Title header      (defaults to "pilot-geo" if unset)
#   OPENROUTER_SITE_URL -> HTTP-Referer header (header omitted entirely if unset)
# OPENROUTER_APP_NAME=pilot-geo
# OPENROUTER_SITE_URL=https://example.com
